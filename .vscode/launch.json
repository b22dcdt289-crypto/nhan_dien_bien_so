{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Nhận diện biển số - structured LeNet",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/recognize_plate_yolo.py",
      "console": "integratedTerminal",
      "args": [
        "${workspaceFolder}/data/VNLP/detection/one_row/1_1010_1_36A38587_102_344_227_413.jpg"
      ],
      "justMyCode": false
    },
    {
      "name": "Train structured pruning",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/structured_prune_lenet5.py",
      "console": "integratedTerminal",
      "args": [
        "--data", "${workspaceFolder}/data/OCR/OCR",
        "--init", "${workspaceFolder}/artifacts/lenet5_ocr_97target_final.pt",
        "--epochs", "10",
        "--output", "${workspaceFolder}/artifacts/lenet5_ocr_structured_pruned25_final.pt"
      ],
      "justMyCode": false
    },
    {
      "name": "Xem bao cao MAC va tham so",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/report_model.py",
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "Xem bao cao model train(1)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/report_model.py",
      "console": "integratedTerminal",
      "args": [
        "--checkpoint",
        "${workspaceFolder}/artifacts/lenet5_train1_structured_pruned25.pt"
      ],
      "justMyCode": false
    },
    {
      "name": "Train model tu train(1)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/finetune_structured_folder.py",
      "console": "integratedTerminal",
      "args": [
        "--data", "${workspaceFolder}/data/VNLP_chars_train1",
        "--init", "${workspaceFolder}/artifacts/lenet5_ocr_structured_pruned25_final.pt",
        "--epochs", "10",
        "--lr", "0.0001",
        "--output", "${workspaceFolder}/artifacts/lenet5_train1_structured_pruned25.pt"
      ],
      "justMyCode": false
    },
    {
      "name": "Xem bao cao pruning 50%",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/report_model.py",
      "console": "integratedTerminal",
      "args": [
        "--checkpoint",
        "${workspaceFolder}/artifacts/lenet5_ocr_pruned50_final.pt"
      ],
      "justMyCode": false
    }
  ]
}
