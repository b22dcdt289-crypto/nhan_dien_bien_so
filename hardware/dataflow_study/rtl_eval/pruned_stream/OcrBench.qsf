set_global_assignment -name FAMILY "MAX 10"
set_global_assignment -name DEVICE 10M50DAF484C7G
set_global_assignment -name TOP_LEVEL_ENTITY Bench_pruned_stream
set_global_assignment -name SYSTEMVERILOG_FILE ../../../de10_lite_ocr_compare/OcrBenchCore.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../../de10_lite_ocr_compare/BenchVariants.sv
set_global_assignment -name SDC_FILE ../../../de10_lite_ocr_compare/OcrBench.sdc
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name NUM_PARALLEL_PROCESSORS 4
set_global_assignment -name INTERNAL_FLASH_UPDATE_MODE "SINGLE IMAGE WITH ERAM"
set_location_assignment PIN_P11 -to MAX10_CLK1_50
set_location_assignment PIN_A8 -to LEDR0
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to MAX10_CLK1_50
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to LEDR0

set_global_assignment -name LAST_QUARTUS_VERSION "25.1std.0 Lite Edition"